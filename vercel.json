{
    "cleanUrls": true,
    "headers": [
        {
            "source": "/(.*).glb",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "model/gltf-binary"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                }
            ]
        },
        {
            "source": "/images/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "max-age=31536000, immutable"
                }
            ]
        }
    ]
}